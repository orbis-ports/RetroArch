# RetroArch for the PlayStation 4 — OpenOrbis toolchain.
#
#   make -f Makefile.orbis -j$(nproc)
#
# ⚠ THIS FILE REPLACED AN orbisdev BUILD, and the two are not variants of one thing.
# The port that stood here from 2018 targeted the orbisdev SDK: $ORBISDEV,
# --target=x86_64-scei-ps4, crt0.o, orbis-elf-create, make_fself.py, -lorbisPad
# -lorbisLink -ldebugnet. Nothing else in ~/src-ps4 speaks that toolchain, and
# orbis-compat — which corrects declarations THIS SDK gets wrong — only exists for
# OpenOrbis. Keeping both would have meant maintaining the corrections twice.
# See ps4/PLAN.md §1 for what the old port was and why none of it survived.
#
# The flags below are a TRANSCRIPTION of orbis-compat/cmake/ps4-openorbis.cmake.
# That file is normative; this one cannot include it (RetroArch is Makefile-driven),
# so when it changes, this changes. The comments that explain WHY a flag is what it
# is live there — only the load-bearing ones are repeated here.

TARGET             := retroarch_orbis

DEBUG              ?= 0
GRIFFIN_BUILD      ?= 0
# Default 1, unlike every other console Makefile: until a libretro core is built
# with this toolchain there is nothing to link, and cores/dynamic_dummy.c is what
# lets the frontend link and boot without one. Phase 6 flips this.
HAVE_STATIC_DUMMY  ?= 1

# ⚠ THE THIRD WAY TO BUILD THIS, and the one Phase 6b is about. With HAVE_DYNAMIC=1 the
# frontend carries no core at all and loads a .prx at run time through
# sceKernelLoadStartModule (libretro-common/dynamic/dylib.c). Cores then live in
# /data/retroarch/cores rather than inside the eboot, and one binary serves all of them.
#
#   make -f Makefile.orbis HAVE_STATIC_DUMMY=0 HAVE_DYNAMIC=1
#
# ⚠ A DYNAMIC CORE MUST CARRY ITS OWN libretro-common. The static build omits those files
# (-DSTATIC_LINKING) because the frontend it is linked into already has them; a module has
# its own symbol table and the frontend's copies are not visible to it. ps4/build-core.sh
# knows the difference.
HAVE_DYNAMIC       ?= 0

# ⚠ PHASE 7: THE RADV PORT, AND IT IS OFF BY DEFAULT UNTIL IT DRAWS. With HAVE_VULKAN=1 the
# frontend links Mesa's RADV as a static ICD and talks to it through orbis-compat's
# vkloader, because this console has no Vulkan loader and cannot have one: the eboot is
# statically linked, there is no libvulkan.so to dlopen and no icd.d to read.
#
#   make -f Makefile.orbis HAVE_VULKAN=1 ...
#
# ⚠ THE HEADERS MUST BE THE ONES THE DRIVER WAS BUILT AGAINST. A mismatched vulkan_core.h
# is a struct-layout bug that compiles cleanly and fails at run time in a way that looks
# like a driver defect. They come out of the Mesa checkout, not the SDK.
HAVE_VULKAN        ?= 0
ORBIS_MESA_SRC     ?= $(HOME)/src-ps4/mesa-ps4
ORBIS_MESA_BUILD   ?= $(ORBIS_MESA_SRC)/build-orbis
RADV_ARCHIVE       := $(ORBIS_MESA_BUILD)/src/amd/vulkan/libvulkan_radeon.a
WHOLE_ARCHIVE_LINK ?= 0

# TITLE_ID is AAAA00000 - four letters, five digits - because param.sfo and the content id
# both embed it and make-pkg.sh rejects anything else. CONTENT_LABEL is <=16 chars.
PS4_TITLE_ID       := RTRA00001
PS4_TITLE_NAME     := RetroArch
PS4_CONTENT_LABEL  := RETROARCH0000000
PS4_PKG_VERSION    := 01.00

# ---------------------------------------------------------------------------
# Toolchain and the platform overlay.
# ---------------------------------------------------------------------------
OO_PS4_TOOLCHAIN   ?= $(HOME)/.local/opt/openorbis
ORBIS_COMPAT_DIR   ?= $(HOME)/src-ps4/orbis-compat
TOOLCHAIN          := $(OO_PS4_TOOLCHAIN)

ifeq ($(wildcard $(TOOLCHAIN)/link.x),)
  $(error OpenOrbis toolchain not found at '$(TOOLCHAIN)'. Set OO_PS4_TOOLCHAIN.)
endif

# ⚠ orbis-compat is not optional and not a convenience. The SDK ships musl's headers
# over Sony's FreeBSD-derived implementation, and the two disagree structurally: four
# pthread types are declared 4 bytes where Sony writes 8 (measured on hardware), and
# the libc++/SDK include order decides whether std::abs(float) silently truncates to
# int. Building without the overlay compiles and is wrong.
ORBIS_COMPAT_LIB   := $(ORBIS_COMPAT_DIR)/build/liborbis-compat.a
ifeq ($(wildcard $(ORBIS_COMPAT_DIR)/include/orbis_prefix.h),)
  $(error orbis-compat not found at '$(ORBIS_COMPAT_DIR)'. Set ORBIS_COMPAT_DIR.)
endif

UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
  OO_BINDIR := $(TOOLCHAIN)/bin/macos
else
  OO_BINDIR := $(TOOLCHAIN)/bin/linux
endif

CC  := clang
CXX := clang++
LD  := clang
AR  := llvm-ar

# ---------------------------------------------------------------------------
# Feature set.
#
# ⚠ NO OPENGL, NO EGL, NO PIGLET. The old build linked -lScePigletv2VSH_stub and
# ran Sony's GLES2 out of the VSH process; this port exists to not need that. Video
# is CPU-drawn (Phase 3) until the RADV port in ~/src-ps4/mesa-ps4 is wired in
# (Phase 7). Enabling HAVE_OPENGL here would pull gfx/drivers_context/orbis_ctx.c,
# which is the Piglet path.
#
# ⚠ RGUI ONLY. XMB, Ozone, MaterialUI and the gfx widgets all want a GL or Vulkan
# driver. RGUI is software and draws its own bitmap font. They come back in Phase 7.
#
# ⚠ NO ONLINE UPDATER, NO CORE DOWNLOADER. Not squeamishness: the build is static
# (HAVE_DYNAMIC=0), so a downloaded core cannot be loaded, and networking is off
# until the socket stack is known good. Shipping menu entries that cannot work is
# worse than not shipping them.
# ---------------------------------------------------------------------------
ifeq ($(GRIFFIN_BUILD),1)
  OBJ += griffin/griffin.o
  DEFINES += -DHAVE_GRIFFIN=1 -DHAVE_MENU -DHAVE_LIBRETRODB -DHAVE_CONFIGFILE
  DEFINES += -DHAVE_RPNG -DHAVE_RWEBP -DHAVE_RDDS -DHAVE_RJPEG -DHAVE_RBMP -DHAVE_RTGA -DHAVE_CC_RESAMPLER
  DEFINES += -DHAVE_CORE_INFO_CACHE
else
  HAVE_MENU                 := 1
  HAVE_MENU_COMMON          := 1
  HAVE_RGUI                 := 1
  HAVE_XMB                  := 0
  HAVE_OZONE                := 0
  HAVE_MATERIALUI           := 0
  HAVE_GFX_WIDGETS          := 0
  HAVE_CONFIGFILE           := 1
  HAVE_LIBRETRODB           := 1
  HAVE_CORE_INFO_CACHE      := 1
  HAVE_LANGEXTRA            := 1
  HAVE_THREADS              := 1
  HAVE_THREAD_ATTR          := 1
  HAVE_RUNAHEAD             := 1
  HAVE_CC_RESAMPLER         := 1
  HAVE_RPNG                 := 1
  HAVE_RJPEG                := 1
  HAVE_RBMP                 := 1
  HAVE_RTGA                 := 1
  HAVE_RWEBP                := 1
  HAVE_RDDS                 := 1
  HAVE_RVORBIS              := 1
  HAVE_RFLAC                := 1
  HAVE_RMP3                 := 1
  HAVE_7ZIP                 := 1
  HAVE_CHD                  := 1
  HAVE_COMPRESSION          := 1
  HAVE_FILTERS_BUILTIN      := 1
  HAVE_STATIC_VIDEO_FILTERS := 1
  HAVE_STATIC_AUDIO_FILTERS := 1
  ifeq ($(HAVE_VULKAN),1)
    HAVE_VULKAN             := 1
    # ⚠ SLANG IS NOT OPTIONAL ONCE VULKAN IS ON. gfx/drivers/vulkan.c calls
    # vulkan_filter_chain_* unconditionally - twenty-odd entry points - and they live in
    # gfx/drivers_shader/shader_vulkan.cpp, which HAVE_SLANG gates. Without it the driver
    # compiles and does not link. glslang and SPIRV-Cross are vendored under deps/, so this
    # costs compile time rather than a new dependency.
    HAVE_SLANG              := 1
    HAVE_SHADERS_COMMON     := 1
    HAVE_BUILTINGLSLANG     := 1
    HAVE_SPIRV_CROSS        := 1
    HAVE_BUILTINSPIRV_CROSS := 1
  endif
  HAVE_NETWORKING           := 0
  HAVE_IFINFO               := 0
  HAVE_SOCKET_LEGACY        := 1
  HAVE_CHEEVOS              := 0
  HAVE_OVERLAY              := 0
  HAVE_MAIN                 := 1
  RARCH_CONSOLE             := 1

  include Makefile.common
  CFLAGS += $(DEF_FLAGS)
  OBJ := $(filter-out $(BLACKLIST),$(OBJ))
endif

# ---------------------------------------------------------------------------
# Flags — transcribed from orbis-compat/cmake/ps4-openorbis.cmake.
# ---------------------------------------------------------------------------
# _BSD_SOURCE: the SDK libc is musl, which hides POSIX declarations when
# __STRICT_ANSI__ is set — which -std=cNN always sets.
# ORBIS/__ORBIS__/__PS4__/PS4: RetroArch's own ifdefs key off ORBIS
# (libretro-common/dynamic/dylib.c), the overlay's off __PS4__. Both, always.
ARCHFLAGS := --target=x86_64-pc-freebsd12-elf -fPIC -funwind-tables \
             -isysroot $(TOOLCHAIN) \
             -DORBIS -D__ORBIS__ -D__PS4__ -DPS4 -D_BSD_SOURCE=1

# ⚠ THE OVERLAY GOES AHEAD OF THE SDK, AND MUST. It corrects musl declarations by
# defining musl's own __DEFINED_<name> guards before bits/alltypes.h is reached.
# Behind the SDK's directory it would compile, do nothing, and say nothing.
C_INCLUDES   := -isystem $(ORBIS_COMPAT_DIR)/include -isystem $(TOOLCHAIN)/include

# ⚠ AND FOR C++, libc++ GOES AHEAD OF BOTH. libc++ ships C-header wrappers that
# #include_next the platform header and add the C++ overloads; the float abs()
# overloads live in libc++'s <stdlib.h>. With the C directory first, std::abs(float)
# resolves to musl's int abs(int) and truncates — silently, at every call site.
# orbis_prefix.h (<stddef.h> + <stdint.h>, nothing else) is needed because the SDK's
# own orbis/*.h are not self-contained.
CXX_INCLUDES := -isystem $(TOOLCHAIN)/include/c++/v1 \
                -isystem $(ORBIS_COMPAT_DIR)/include -isystem $(TOOLCHAIN)/include \
                -include orbis_prefix.h

INCDIRS += -I. -Ideps -Ilibretro-common/include -Ideps/rcheevos/include \
           -I$(ORBIS_COMPAT_DIR)/include

ifeq ($(HAVE_VULKAN),1)
  ifeq ($(wildcard $(RADV_ARCHIVE)),)
    $(error No RADV archive at $(RADV_ARCHIVE). Build it with mesa-ps4's build.sh, or set ORBIS_MESA_BUILD.)
  endif
  # The driver's own headers first, and the loader's, which declares vk_icdGetInstanceProcAddr.
  INCDIRS += -I$(ORBIS_MESA_SRC)/include -I$(ORBIS_COMPAT_DIR)/vkloader
  # ⚠ ONE ARCHIVE, NOT THREE. meson merges addrlib and amd_common into libvulkan_radeon.a
  # and also emits them separately; adding those produces a thousand duplicate-symbol
  # errors that read as a broken driver. --whole-archive because a statically linked driver
  # must have all of itself present - nothing later will dlopen the members the linker
  # decided were unreachable.
  RADV_LINK := -Wl,--whole-archive $(RADV_ARCHIVE) -Wl,--no-whole-archive
endif

# ⚠ THE LOG CHANNEL IS ADOPTED BY NAMING ITS SOURCE, which is how orbis-compat/optional
# is meant to be used: it is POLICY, not correction, so it is deliberately NOT inside
# liborbis-compat.a. ps4_app.cpp decides that a dying process idles rather than returns
# and obliges the link to carry -lSceNet; orbis_netlog.cpp is the UDP transport under it.
# Both register into orbis_log.h's hooks, which is how the overlay's own corrections get
# a channel without knowing this file exists.
ORBIS_COMPAT_OBJ := ps4/oc_ps4_app.o ps4/oc_netlog.o ps4/ps4_log.o ps4/ps4_mem.o ps4/ps4_video_out.o

# ⚠ APPENDED AFTER THE := ABOVE, for the fourth time in this file and the same reason
# every time: a `+=` that runs before the assignment it means to extend is thrown away.
# This one cost an "undefined symbol: vkGetInstanceProcAddr" for a function whose source
# file was sitting right there, simply never compiled.
ifeq ($(HAVE_VULKAN),1)
  ORBIS_COMPAT_OBJ += ps4/oc_vkloader.o ps4/oc_vkthunks.o
endif
OBJ += $(ORBIS_COMPAT_OBJ)

# Where the datagrams go, and what the first log line says the console is running.
# scripts/ps4/logs.sh in orbis-compat binds this port.
PS4_NETLOG_HOST ?= 192.168.100.1
PS4_NETLOG_PORT ?= 18194
PS4_APP_STAMP   := $(shell date -u '+%Y-%m-%d %H:%M') $(shell git rev-parse --short HEAD 2>/dev/null)$(shell git diff --quiet 2>/dev/null || echo -dirty)
OC_DEFINES      := -DNETLOG_HOST='"$(PS4_NETLOG_HOST)"' -DNETLOG_PORT=$(PS4_NETLOG_PORT) \
                   -DPS4_APP_BUILD_STAMP='"$(PS4_APP_STAMP)"'

DEFINES += -DRARCH_INTERNAL -DRARCH_CONSOLE -DHAVE_FILTERS_BUILTIN

# ⚠ -Werror IS DELIBERATELY OFF, and the old build's was load-bearing for nothing:
# it was only ever exercised by a CI job that linked HAVE_STATIC_DUMMY against stub
# headers, so it never saw a real translation unit. Turning it back on is a task for
# after the port compiles, with the warning list read rather than pre-suppressed.
# These four are suppressed because the SDK's own headers produce them:
DEFINES += -Wno-macro-redefined -Wno-typedef-redefinition \
           -Wno-non-literal-null-conversion -Wno-implicit-function-declaration

# ⚠ THIS BLOCK GOES BEFORE CFLAGS IS COMPOSED. CFLAGS is a := assignment, so a DEFINES
# appended after it never reaches the compiler - which is how the first build of this
# file compiled all 261 objects and then failed to link on twenty undefined retro_*
# symbols: cores/dynamic_dummy.c had not seen -DHAVE_STATIC_DUMMY.
ifeq ($(HAVE_DYNAMIC),1)
  DEFINES  += -DHAVE_DYNAMIC
  CORE_LIB :=
else ifeq ($(HAVE_STATIC_DUMMY),1)
  DEFINES  += -DHAVE_STATIC_DUMMY
  CORE_LIB :=
else
  CORE_LIB := $(WHOLE_START) -lretro_orbis $(WHOLE_END)
endif

# ⚠ $(INCLUDE_DIRS) AS WELL AS $(INCDIRS), AND ITS ABSENCE WAS A LATENT BUG FROM THE FIRST
# BUILD. Makefile.common appends every include path it needs to INCLUDE_DIRS - a different
# variable from the INCDIRS this file composes - so all of them were being dropped on the
# floor. Nothing noticed while the feature set was small enough that no enabled block added
# one; turning on SPIRV-Cross did, and the symptom was `spirv_glsl.hpp file not found` for
# a header sitting in a directory the compiler was never told about.
CFLAGS   := $(ARCHFLAGS) $(C_INCLUDES)   $(INCDIRS) $(INCLUDE_DIRS) $(DEFINES) $(CFLAGS)
CXXFLAGS := $(ARCHFLAGS) $(CXX_INCLUDES) $(INCDIRS) $(INCLUDE_DIRS) $(DEFINES)

ifeq ($(DEBUG),1)
  CFLAGS   += -O0 -g -fno-inline
  CXXFLAGS += -O0 -g -fno-inline
else
  CFLAGS   += -O2
  CXXFLAGS += -O2
endif

# ---------------------------------------------------------------------------
# Link.
#
# --no-rosegment: modern ld.lld emits a separate, non-page-aligned read-only
# PT_LOAD. The PS4 loader rounds segment sizes to 0x1000 and maps raw p_vaddr, so
# that extra segment overlaps the text segment and the image is rejected.
#
# --whole-archive on orbis-compat: nothing REFERENCES an interposer. backtrace,
# __mmap and the rest exist to be preferred over the SDK's definitions, and a linker
# pulls an archive member in only when something already wants it.
#
# crt1.o last, after the SDK libs — the order the SDK's own link rule uses.
# ---------------------------------------------------------------------------
# -lSceNet is here for the log channel, not for networking: ps4_app tees every line
# over a UDP datagram to the dev host, and that is the only channel that says anything
# when the console is not next to a TV. HAVE_NETWORKING stays 0.
PS4_LIBS := -lSceVideoOut -lScePad -lSceAudioOut -lSceUserService \
            -lSceSystemService -lSceSysmodule -lSceIme -lSceNet

# ⚠ APPENDED HERE AND NOT WHERE HAVE_VULKAN IS HANDLED, because PS4_LIBS is a := assignment
# further down the file than that block: appending up there is overwritten by the line
# above. The same shape of mistake as the HAVE_STATIC_DUMMY ordering earlier in this file,
# and worth the second comment.
#
# The RADV archive drives the GNM ring itself - it submits command buffers and sets the
# shader stages - so libSceGnmDriver is a dependency of the DRIVER rather than of any
# particular frontend, and orbis-compat's vkloader declares it the same way.
ifeq ($(HAVE_VULKAN),1)
  PS4_LIBS += -lSceGnmDriver
endif

LDFLAGS := -nostdlib -fuse-ld=lld -pie --target=x86_64-pc-freebsd12-elf \
           -Wl,-m,elf_x86_64 -Wl,--script=$(TOOLCHAIN)/link.x \
           -Wl,--eh-frame-hdr -Wl,--no-rosegment \
           -L$(TOOLCHAIN)/lib -Lcores -Lbuild

ifeq ($(WHOLE_ARCHIVE_LINK),1)
  WHOLE_START := -Wl,--whole-archive
  WHOLE_END   := -Wl,--no-whole-archive
endif

LIBS := $(CORE_LIB) $(RADV_LINK) $(PS4_LIBS) \
        -Wl,--whole-archive $(ORBIS_COMPAT_LIB) -Wl,--no-whole-archive \
        -lc -lkernel -lc++ -lc++abi -lunwind $(TOOLCHAIN)/lib/crt1.o

# ---------------------------------------------------------------------------
# Rules.
# ---------------------------------------------------------------------------
ifneq ($(V),1)
  Q := @
endif

# ⚠ OBJECTS DEPEND ON THE FLAGS THEY WERE BUILT WITH, and make does not know that on its
# own. Switching HAVE_DYNAMIC or HAVE_STATIC_DUMMY changes DEFINES for every translation
# unit while leaving every .o newer than its .c, so the next build links objects compiled
# under two different configurations. That has now cost two confusing link failures - the
# first blamed on cores/dynamic_dummy.c, the second on the core loader - and both times the
# object was simply stale.
#
# The stamp holds the flags; it is rewritten only when they actually change, so a no-op
# build stays a no-op and a changed switch rebuilds everything that saw it.
PS4_CONFIG_STAMP := .ps4-build-config
PS4_CONFIG_NOW   := $(CFLAGS) | $(CXXFLAGS) | $(LIBS)
$(shell test "$$(cat $(PS4_CONFIG_STAMP) 2>/dev/null)" = "$(PS4_CONFIG_NOW)" \
  || printf '%s' "$(PS4_CONFIG_NOW)" > $(PS4_CONFIG_STAMP))

# ⚠ .DEFAULT_GOAL BEFORE THE RULE BELOW, NOT AFTER. A rule's first target becomes the
# default goal, and $(OBJ) begins with version_git.o - so adding this dependency silently
# made `make -f Makefile.orbis` build one object file and stop, reporting success.
.DEFAULT_GOAL := all

$(OBJ): $(PS4_CONFIG_STAMP)

OBJOUT  := -o
TARGETS := $(TARGET).elf eboot.bin

all: $(TARGETS)

define INFO
CC:        $(CC)
CFLAGS:    $(CFLAGS)
CXXFLAGS:  $(CXXFLAGS)
LD:        $(LD)
LDFLAGS:   $(LDFLAGS)
LIBS:      $(LIBS)
TOOLCHAIN: $(TOOLCHAIN)
OVERLAY:   $(ORBIS_COMPAT_DIR)
OBJ:       $(OBJ)
endef
export INFO

info:
	@echo "$$INFO"

%.o: %.c
	@$(if $(Q), $(shell echo echo CC $<),)
	$(Q)$(CC) $(CFLAGS) -c $(OBJOUT)$@ $<

%.o: %.cpp
	@$(if $(Q), $(shell echo echo CXX $<),)
	$(Q)$(CXX) $(CXXFLAGS) -c $(OBJOUT)$@ $<

%.o: %.S
	@$(if $(Q), $(shell echo echo CC $<),)
	$(Q)$(CC) $(CFLAGS) -c $(OBJOUT)$@ $<

ps4/oc_ps4_app.o: $(ORBIS_COMPAT_DIR)/optional/ps4_app.cpp
	@$(if $(Q), $(shell echo echo CXX $<),)
	$(Q)$(CXX) $(CXXFLAGS) $(OC_DEFINES) -c $(OBJOUT)$@ $<

ps4/oc_vkloader.o: $(ORBIS_COMPAT_DIR)/vkloader/vkloader.c
	@$(if $(Q), $(shell echo echo CC $<),)
	$(Q)$(CC) $(CFLAGS) -c $(OBJOUT)$@ $<

ps4/oc_vkthunks.o: $(ORBIS_COMPAT_DIR)/vkloader/vkthunks.c
	@$(if $(Q), $(shell echo echo CC $<),)
	$(Q)$(CC) $(CFLAGS) -c $(OBJOUT)$@ $<

ps4/oc_netlog.o: $(ORBIS_COMPAT_DIR)/optional/orbis_netlog.cpp
	@$(if $(Q), $(shell echo echo CXX $<),)
	$(Q)$(CXX) $(CXXFLAGS) $(OC_DEFINES) -c $(OBJOUT)$@ $<

$(ORBIS_COMPAT_LIB):
	$(error orbis-compat is not built: no $(ORBIS_COMPAT_LIB). Run ./build.sh in $(ORBIS_COMPAT_DIR).)

$(TARGET).elf: $(OBJ) $(ORBIS_COMPAT_LIB)
	@$(if $(Q), $(shell echo echo LD $@),)
	$(Q)$(LD) $(OBJ) $(LDFLAGS) $(LIBS) -o $@

# create-fself turns the ELF into an Orbis ELF and the eboot.bin a console expects.
# unemups4 loads the plain .elf directly, so the eboot is only the hardware path.
# PAID 0x3800000000000011 is the value every OpenOrbis sample uses for homebrew.
eboot.bin: $(TARGET).elf
	@$(if $(Q), $(shell echo echo FSELF $@),)
	$(Q)$(OO_BINDIR)/create-fself -in=$(TARGET).elf -out=$(TARGET).oelf \
		--eboot $@ --paid 0x3800000000000011 >/dev/null

# ⚠ THE .pkg IS THE ONLY THING A CONSOLE CAN INSTALL. eboot.bin alone is what unemups4
# loads; hardware wants a fake-signed package around it. The recipe is not reimplemented
# here - orbis-compat/scripts/ps4/make-pkg.sh is the same sequence the CMake consumers use
# (PkgTool.Core sfo_new/sfo_setentry -> create-gp4 -> pkg_build), and it is deliberately
# usable standalone.
#
# Nothing but the executable goes in. RGUI draws its own bitmap font and needs no assets,
# there is no core to ship yet, and everything writable resolves under /data, which the
# frontend creates on first boot. A package that shipped assets it could not use would
# only make the first hardware run slower to copy.
PS4_MAKE_PKG := $(ORBIS_COMPAT_DIR)/scripts/ps4/make-pkg.sh

pkg: eboot.bin
	@$(if $(Q), $(shell echo echo PKG $(PS4_TITLE_ID)),)
	$(Q)OO_PS4_TOOLCHAIN=$(TOOLCHAIN) $(PS4_MAKE_PKG) \
		--eboot eboot.bin --out-dir . \
		--title-id $(PS4_TITLE_ID) --title "$(PS4_TITLE_NAME)" \
		--version $(PS4_PKG_VERSION) --content-label $(PS4_CONTENT_LABEL) \
		--sdk $(TOOLCHAIN)

# Upload to the console over GoldHEN's FTP. lftp rather than curl: it is what the packages
# in /data/pkg were put there with, and it retries a stalled transfer instead of leaving a
# truncated .pkg that the installer accepts and then fails on.
#
#   make -f Makefile.orbis send PS4=192.168.100.2
#
# Install afterwards ON THE CONSOLE: Settings -> Debug Settings -> Package Installer ->
# /data/pkg/retroarch.pkg. Nothing here can do that half.
PS4        ?= 192.168.100.2
PS4_FTP_PORT ?= 2121
PKG_REMOTE ?= /data/pkg
PKG_NAME   ?= retroarch.pkg
PKG_FILE   := IV0000-$(PS4_TITLE_ID)_00-$(PS4_CONTENT_LABEL).pkg

send: pkg
	@echo "FTP $(PKG_FILE) -> $(PS4):$(PKG_REMOTE)/$(PKG_NAME)"
	$(Q)lftp -c "set net:timeout 10; set ftp:passive-mode on; \
		open -p $(PS4_FTP_PORT) $(PS4); mkdir -p $(PKG_REMOTE); \
		put -O $(PKG_REMOTE) $(PKG_FILE) -o $(PKG_NAME)"
	@echo "uploaded. Install via Debug Settings -> Package Installer on the console."

clean:
	$(Q)rm -f $(OBJ) $(TARGET).elf $(TARGET).oelf eboot.bin pkg.gp4 $(PS4_CONFIG_STAMP)
	$(Q)rm -rf sce_sys

.PHONY: all clean info pkg send
