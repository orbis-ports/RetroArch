From: PS4 port
Subject: [PATCH] orbis: give the memory arena a real implementation

⚠ THIS REPLACES AN EARLIER PATCH THAT ONLY MADE THE FILE COMPILE, AND WHOSE COMMENT WAS WRONG.
That one named __ORBIS__ in the platform branches, left Create() falling through to `return false`,
and claimed the arena "backs fastmem, and swanstation runs without it". It does not: bus.cpp:263
allocates the console's ENTIRE RAM through it -

    if (!m_memory_arena.Create(MEMORY_ARENA_SIZE, true, false))
      return false;
    g_ram = m_memory_arena.CreateViewPtr(MEMORY_ARENA_RAM_OFFSET, ram_size, true, false);

- so a failing Create means no g_ram, and the core reported, on hardware:

    [Common::MemoryArena] File mapping name: swanstation_323_0x8009dd710
    ERROR: Failed to allocate memory
    ERROR: System failed to boot. The log may contain more information.

MEMORY_ARENA_SIZE is RAM_8MB_SIZE - eight megabytes. The reason the upstream code reaches for
shared memory is not size, it is fastmem: FASTMEM_REGION_SIZE is 4 GiB and the same RAM has to
appear at many fixed addresses inside it, which needs one object mapped repeatedly. This SDK has
no shm_open, no memfd_create, and no POSIX way to say "those same pages, over there".

So the arena is one anonymous mapping and a view is an OFFSET into it. Everything that only needs
the RAM once works; CreateViewPtr refuses a fixed address, which makes Bus::UpdateFastmemViews
fall back to its slow path. That is a speed trade, not a correctness one - and answering a fixed
address with unrelated memory would be neither.

⚠ ReleaseViewPtr DELIBERATELY DOES NOT UNMAP. A view is a pointer into the arena, so unmapping it
would punch a hole in the middle of the console's RAM; Destroy() releases the whole thing.

Left for later: sceKernelAllocateDirectMemory + sceKernelMapDirectMemory can map the same physical
pages at several addresses, which is exactly what fastmem wants, and is what
beetle-psx-libretro/ps4/orbis_lightrec_mem.c already does for Lightrec's code buffer.

diff --git a/src/common/memory_arena.cpp b/src/common/memory_arena.cpp
index e152428..d478b79 100644
--- a/src/common/memory_arena.cpp
+++ b/src/common/memory_arena.cpp
@@ -12,7 +12,7 @@ Log_SetChannel(Common::MemoryArena);
 #include <sys/ioctl.h>
 #include <sys/mman.h>
 #include <unistd.h>
-#elif defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__)
+#elif defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__) || defined(__ORBIS__)
 #include <cerrno>
 #include <fcntl.h>
 #include <sys/mman.h>
@@ -97,6 +97,8 @@ bool MemoryArena::IsValid() const
 {
 #if defined(_WIN32)
   return m_file_handle != nullptr;
+#elif defined(__ORBIS__)
+  return m_base != nullptr;
 #else
   return m_shmem_fd >= 0;
 #endif
@@ -106,7 +108,7 @@ static std::string GetFileMappingName()
 {
 #if defined(_WIN32)
   const unsigned pid = GetCurrentProcessId();
-#elif defined(__ANDROID__) || defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__)
+#elif defined(__ANDROID__) || defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__) || defined(__ORBIS__)
   const unsigned pid = static_cast<unsigned>(getpid());
 #else
 #error Unknown platform.
@@ -125,7 +127,25 @@ bool MemoryArena::Create(size_t size, bool writable, bool executable)
 
   const std::string file_mapping_name(GetFileMappingName());
 
-#if defined(_WIN32)
+#if defined(__ORBIS__)
+  // ⚠ NO shm_open ON THIS SDK, SO THERE IS NO SHARED OBJECT TO MAP TWICE. The arena is one
+  // anonymous mapping and every view is an offset into it. MEMORY_ARENA_SIZE is RAM_8MB_SIZE -
+  // eight megabytes - so this is the console's RAM and nothing more; the 4 GiB fastmem region is
+  // a separate request that CreateViewPtr declines below.
+  m_base = mmap(nullptr, size, PROT_READ | (writable ? PROT_WRITE : 0),
+                MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (m_base == MAP_FAILED)
+  {
+    m_base = nullptr;
+    Log_ErrorPrintf("mmap(%zu) for the memory arena failed: %d", size, errno);
+    return false;
+  }
+
+  m_size = size;
+  m_writable = writable;
+  m_executable = executable;
+  return true;
+#elif defined(_WIN32)
   const DWORD protect = (writable ? (executable ? PAGE_EXECUTE_READWRITE : PAGE_READWRITE) : PAGE_READONLY);
   m_file_handle = CreateFileMappingA(INVALID_HANDLE_VALUE, nullptr, protect, static_cast<uint32_t>(size >> 16 >> 16), static_cast<uint32_t>(size),
                                      file_mapping_name.c_str());
@@ -215,6 +235,12 @@ void MemoryArena::Destroy()
     CloseHandle(m_file_handle);
     m_file_handle = nullptr;
   }
+#elif defined(__ORBIS__)
+  if (m_base)
+  {
+    munmap(m_base, m_size);
+    m_base = nullptr;
+  }
 #elif defined(__linux__) || defined(__FreeBSD__)
   if (m_shmem_fd > 0)
   {
@@ -259,6 +285,15 @@ void* MemoryArena::CreateViewPtr(size_t offset, size_t size, bool writable, bool
   base_pointer = mmap(fixed_address, size, prot, flags, m_shmem_fd, static_cast<off_t>(offset));
   if (base_pointer == reinterpret_cast<void*>(-1))
     return nullptr;
+#elif defined(__ORBIS__)
+  // ⚠ A VIEW IS AN OFFSET, NOT A SECOND MAPPING - which is exactly what fastmem needs and cannot
+  // have here. fastmem asks for the SAME RAM at a fixed address inside a 4 GiB window, and without
+  // shared memory there is no way to map one page twice. Refusing a fixed address makes
+  // Bus::UpdateFastmemViews fall back to the slow path, which is a speed question rather than a
+  // correctness one; answering with unrelated memory would be neither.
+  if (fixed_address != nullptr || !m_base || (offset + size) > m_size)
+    return nullptr;
+  base_pointer = static_cast<uint8_t*>(m_base) + offset;
 #else
   return nullptr;
 #endif
@@ -273,6 +308,9 @@ bool MemoryArena::FlushViewPtr(void* address, size_t size)
   return FlushViewOfFile(address, size);
 #elif defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__)
   return (msync(address, size, 0) >= 0);
+#elif defined(__ORBIS__)
+  // Nothing to flush: the view IS the arena's own memory.
+  return true;
 #else
   return false;
 #endif
@@ -285,6 +323,10 @@ bool MemoryArena::ReleaseViewPtr(void* address, size_t size)
   result = static_cast<bool>(UnmapViewOfFile(address));
 #elif defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__)
   result = (munmap(address, size) >= 0);
+#elif defined(__ORBIS__)
+  // The view was never a mapping of its own, so there is nothing to unmap - Destroy() releases the
+  // whole arena. Unmapping here would punch a hole in the middle of the console's RAM.
+  result = true;
 #else
   result = false;
 #endif
@@ -304,7 +346,7 @@ void* MemoryArena::CreateReservedPtr(size_t size, void* fixed_address /*= nullpt
   void* base_pointer;
 #if defined(_WIN32)
   base_pointer = VirtualAlloc(fixed_address, size, MEM_RESERVE, PAGE_NOACCESS);
-#elif defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__)
+#elif defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__) || defined(__ORBIS__)
   const int flags =
     (fixed_address != nullptr) ? (MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED) : (MAP_PRIVATE | MAP_ANONYMOUS);
   base_pointer = mmap(fixed_address, size, PROT_NONE, flags, -1, 0);
@@ -349,7 +391,7 @@ bool MemoryArena::SetPageProtection(void* address, size_t length, bool readable,
   DWORD old_protect;
   return static_cast<bool>(
     VirtualProtect(address, length, protection_table[readable][writable][executable], &old_protect));
-#elif defined(__linux__) || defined(__ANDROID__) || defined(__APPLE__) || defined(__FreeBSD__)
+#elif defined(__linux__) || defined(__ANDROID__) || defined(__APPLE__) || defined(__FreeBSD__) || defined(__ORBIS__)
   const int prot = (readable ? PROT_READ : 0) | (writable ? PROT_WRITE : 0) | (executable ? PROT_EXEC : 0);
   return (mprotect(address, length, prot) >= 0);
 #else
diff --git a/src/common/memory_arena.h b/src/common/memory_arena.h
index 655b6a0..e4ec80a 100644
--- a/src/common/memory_arena.h
+++ b/src/common/memory_arena.h
@@ -56,6 +56,9 @@ public:
 private:
 #if defined(_WIN32)
   void* m_file_handle = nullptr;
+#elif defined(__ORBIS__)
+  // One ordinary anonymous mapping; views are offsets into it. See memory_arena.cpp.
+  void* m_base = nullptr;
 #elif defined(__linux__) || defined(ANDROID) || defined(__APPLE__) || defined(__FreeBSD__)
   int m_shmem_fd = -1;
 #endif
