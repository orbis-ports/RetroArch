From: PS4 port
Subject: [PATCH] orbis: give the JIT code buffer a platform, and make it report

The recompiler died before emitting anything:

    [InitializeFastmem] Failed to install page fault handler
    libc++abi: terminating with uncaught exception of type Xbyak::Error

Xbyak was not the culprit - it is handed a buffer rather than allocating one
(cpu_recompiler_code_generator_x64.cpp:2225 passes host_pc), so the throw came from being given
nothing. JitCodeBuffer::Allocate had returned false, for the reason that keeps catching this port:

    #elif defined(__linux__) || defined(__ANDROID__) || defined(__APPLE__) || defined(__HAIKU__) \
       || defined(__FreeBSD__)

__FreeBSD__ is undefined in every C++ TU here - this SDK's libc++ clears it on purpose so that a
libc++ built against musl does not take FreeBSD's arms - and nothing names __ORBIS__. The chain
fell through to `#else return false;`.

Naming the platform is not enough, because the POSIX arm then does two things this kernel refuses:

  * it maps with PROT_READ | PROT_WRITE | PROT_EXEC in ONE call. This kernel refuses PROT_EXEC at
    map time and grants it to mprotect afterwards - the finding
    beetle-psx-libretro/ps4/orbis_lightrec_mem.c rests on.
  * ⚠ it checks the result with `if (!m_code_ptr)`. mmap reports failure as MAP_FAILED, which is
    (void*)-1 and not NULL, so a refused mapping passes that test and travels on as a pointer.
    Latent on every platform this arm serves.

⚠ AND IT NOW REPORTS WHETHER THE PROMOTION WORKED, which matters more here than elsewhere: the
buffer is a 48 MB static array in the module's .bss, and that is exactly the memory that needed
explicit promotion for s_fast_map (patch 0004). A silent `return false` shows up downstream as a
guard-page bug in a different file.

diff --git a/src/common/jit_code_buffer.cpp b/src/common/jit_code_buffer.cpp
--- a/src/common/jit_code_buffer.cpp
+++ b/src/common/jit_code_buffer.cpp
@@ -1,4 +1,9 @@
 #include "jit_code_buffer.h"
+#ifdef __ORBIS__
+#include "log.h"
+#include <cerrno>
+Log_SetChannel(JitCodeBuffer);
+#endif
 #include "align.h"
 #include "platform.h"
 #include <algorithm>
@@ -32,6 +37,24 @@
   m_code_ptr = static_cast<uint8_t*>(VirtualAlloc(nullptr, m_total_size, MEM_COMMIT, PAGE_EXECUTE_READWRITE));
   if (!m_code_ptr)
     return false;
+#elif defined(__ORBIS__)
+  // ⚠ RW FIRST, EXEC AFTER, AND MAP_FAILED IS -1 RATHER THAN NULL. This kernel refuses PROT_EXEC
+  // at map time and grants it to mprotect afterwards - the same finding
+  // beetle-psx-libretro/ps4/orbis_lightrec_mem.c rests on. And the POSIX arm below checks the
+  // result with `if (!m_code_ptr)`, which mmap failure does not satisfy: it returns (void*)-1.
+  m_code_ptr = static_cast<uint8_t*>(
+    mmap(nullptr, m_total_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
+  if (m_code_ptr == MAP_FAILED)
+  {
+    m_code_ptr = nullptr;
+    return false;
+  }
+  if (mprotect(m_code_ptr, m_total_size, PROT_READ | PROT_WRITE | PROT_EXEC) != 0)
+  {
+    munmap(m_code_ptr, m_total_size);
+    m_code_ptr = nullptr;
+    return false;
+  }
 #elif defined(__linux__) || defined(__ANDROID__) || defined(__APPLE__) || defined(__HAIKU__) || defined(__FreeBSD__)
   int flags = MAP_PRIVATE | MAP_ANONYMOUS;
 #if defined(__APPLE__) && defined(__aarch64__)
@@ -83,6 +106,18 @@
 
   m_code_ptr = static_cast<uint8_t*>(buffer);
   m_old_protection = static_cast<uint32_t>(old_protect);
+#elif defined(__ORBIS__)
+  // ⚠ REPORTED, NOT ASSUMED. This path returned false without a word, and here the buffer is a
+  // 48 MB static array in the module's .bss - the same memory that needed explicit promotion for
+  // s_fast_map. A silent false looks downstream like a guard-page bug.
+  if (mprotect(buffer, size, PROT_READ | PROT_WRITE | PROT_EXEC) != 0)
+  {
+    Log_ErrorPrintf("orbis: mprotect(code buffer %p, %u KiB, rwx) failed, errno %d",
+                    buffer, size / 1024, errno);
+    return false;
+  }
+  Log_InfoPrintf("orbis: code buffer %p, %u KiB promoted rwx; guard %u KiB",
+                 buffer, size / 1024, guard_size / 1024);
 #elif defined(__linux__) || defined(__ANDROID__) || defined(__APPLE__) || defined(__HAIKU__) || defined(__FreeBSD__)
   if (mprotect(buffer, size, PROT_READ | PROT_WRITE | PROT_EXEC) != 0)
     return false;
@@ -91,7 +126,12 @@
   {
     uint8_t* guard_at_end = (static_cast<uint8_t*>(buffer) + size) - guard_size;
     if (mprotect(buffer, guard_size, PROT_NONE) != 0 || mprotect(guard_at_end, guard_size, PROT_NONE) != 0)
+    {
+#ifdef __ORBIS__
+      Log_ErrorPrintf("orbis: mprotect(guard, %u KiB) failed, errno %d", guard_size / 1024, errno);
+#endif
       return false;
+    }
   }
 
   // reasonable default?
@@ -125,7 +165,7 @@
   {
 #if defined(_WIN32)
     VirtualFree(m_code_ptr, 0, MEM_RELEASE);
-#elif defined(__linux__) || defined(__ANDROID__) || defined(__APPLE__) || defined(__HAIKU__) || defined(__FreeBSD__)
+#elif defined(__linux__) || defined(__ANDROID__) || defined(__APPLE__) || defined(__HAIKU__) || defined(__FreeBSD__) || defined(__ORBIS__)
     munmap(m_code_ptr, m_total_size);
 #endif
   }
