@@ -22,10 +22,33 @@ static constexpr bool huge_va = std::numeric_limits<size_t>::max() > 0x100000000
 // On 64-bit systems, we will never allocate more than one block, this is important since we must ensure that
 // relative jumps are reachable in 32-bits.
 // We won't actually allocate 1 GB on 64-bit, but just reserve VA space for it, which we have basically an infinite amount of.
+#if defined(__ORBIS__)
+// ⚠ THE RESERVE-AND-COMMIT SPLIT THIS FILE IS BUILT AROUND DOES NOT EXIST ON THIS CONSOLE.
+// Executable pages here come from direct memory, and direct memory hands out PHYSICAL pages at
+// allocation time - there is no PROT_NONE reservation to grow into later. So the number below is
+// not a ceiling to reserve, it is memory that is really taken, and on a console with no swap
+// asking for the gigabyte above would simply fail.
+//
+// 64 MiB, and the single-block invariant in the comment above is the reason it is one number
+// rather than a growth policy: the RSP's instruction memory is 4 KiB, so this is a very large
+// arena for what compiles into it, and staying inside one block keeps every relative jump the
+// JIT emits reachable by construction. If it is ever exhausted the abort in allocate_code below
+// fires and says so, which is a better failure than a second block two gigabytes away.
+static constexpr size_t block_size = 64 * 1024 * 1024;
+// RetroArch/ps4/orbis_exec_mem.c, linked in by the port's build harness.
+extern "C" void *orbis_exec_mem_alloc(size_t size);
+extern "C" void  orbis_exec_mem_free(void *addr, size_t size);
+#else
 static constexpr size_t block_size = huge_va ? (1024 * 1024 * 1024) : (2 * 1024 * 1024);
+#endif
 Allocator::~Allocator()
 {
-#ifdef _WIN32
+#if defined(__ORBIS__)
+	// munmap alone would leave the physical pages allocated: direct memory is released by the
