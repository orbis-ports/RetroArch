 	EXPORT unsigned int CALL parallelRSPDoRspCycles(unsigned int cycles)
 	{
+		/* ⚠ THE RSP RUNS ON THE CPU. It is a programmable vector DSP executing the game's own
+		 * microcode, recompiled here by GNU lightning, and it runs beside the recompiled R4300
+		 * with no GPU in the path at all - which is the thing most easily misread about a core
+		 * advertised as "ParaLLEl-RDP on Vulkan". Only the RDP half is on the GPU. */
+		ORBIS_TIME(3, "rsp-lle");
