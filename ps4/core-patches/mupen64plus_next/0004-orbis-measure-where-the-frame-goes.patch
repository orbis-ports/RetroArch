+}
+namespace {
+struct OrbisSlotTimer {
+	int slot; const char *name; unsigned long long t0; bool on;
+	OrbisSlotTimer(int s, const char *n) : slot(s), name(n), t0(0), on(orbis_profile_enabled() != 0)
+	{ if (on) t0 = orbis_profile_now(); }
+	~OrbisSlotTimer() { if (on) orbis_profile_add(slot, name, orbis_profile_now() - t0); }
+};
+}
+#define ORBIS_TIME(s, n) OrbisSlotTimer orbis_timer_(s, n)
+#else
+#define ORBIS_TIME(s, n) do {} while (0)
