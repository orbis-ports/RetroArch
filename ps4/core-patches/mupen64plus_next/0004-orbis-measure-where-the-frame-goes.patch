 void parallelProcessRDPList(void)
 {
+#ifdef __ORBIS__
+	/* This is the RDP half, and it is the half people assume is "on the GPU". Building and
+	 * submitting the command stream is CPU work; whether a GPU wait lands here too depends on
+	 * the synchronous-RDP option. Measuring it settles both. */
+	if (orbis_profile_enabled())
+	{
+		unsigned long long t0 = orbis_profile_now();
+		RDP::process_commands();
+		orbis_profile_add(2, "rdp-submit", orbis_profile_now() - t0);
+		return;
+	}
