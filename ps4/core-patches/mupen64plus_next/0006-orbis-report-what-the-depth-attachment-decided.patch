@@ -15,6 +15,14 @@
 
 using namespace opengl;
 
+#ifdef __ORBIS__
+/* GLideN64 is built with LOG_LEVEL LOG_NONE, so every warning this function writes is discarded
+ * before it is formatted. These are the five decisions that shape what depth ends up meaning on
+ * this platform, and none of them is visible any other way. One line, once, at context creation. */
+extern "C" void orbis_report(const char *tag, const char *fmt, ...)
+	__attribute__((format(printf, 2, 3)));
+#endif
+
 static
 void APIENTRY on_gl_error(GLenum source,
 						GLenum type,
@@ -271,4 +279,25 @@ void GLInfo::init() {
 	glDebugMessageControl(GL_DONT_CARE, GL_DONT_CARE, GL_DONT_CARE, 0, NULL, GL_TRUE);
 	glEnable(GL_DEBUG_OUTPUT_SYNCHRONOUS);
 #endif
+
+#ifdef __ORBIS__
+	/* ⚠ enableClipping and enableFragmentDepthWrite are a PAIR and this build splits them.
+	 * The vertex shader emits `gl_Position.z /= 8.0` whenever enableClipping is set - forced to 1
+	 * for every GLES context a few lines above - and the only code that scales it back lives in
+	 * writeDepth(), which is compiled to `return 0.0;` when enableFragmentDepthWrite is 0. That is
+	 * this build's configuration: mupen64plus-next defaults EnableFragmentDepthWrite to False
+	 * under HAVE_OPENGLES. Depth ordering survives the /8 because it is monotonic; near-plane
+	 * clipping does not, which is what the pair was for. Printed so the combination is on the
+	 * record rather than inferred from two headers. */
+	orbis_report("gliden64",
+		"GL %d.%d %s | depthTexture %d weakBlit(GLES) %d noPerspective %d imageTextures %d | "
+		"fbEmulation %u fragDepthWrite %u clipping %u n64DepthCompare %u copyDepthToRDRAM %u",
+		majorVersion, minorVersion, isGLESX ? "ES" : "core",
+		(int)depthTexture, (int)isGLESX, (int)noPerspective, (int)imageTextures,
+		config.frameBufferEmulation.enable,
+		config.generalEmulation.enableFragmentDepthWrite,
+		config.generalEmulation.enableClipping,
+		(unsigned)config.frameBufferEmulation.N64DepthCompare,
+		(unsigned)config.frameBufferEmulation.copyDepthToRDRAM);
+#endif
 }
