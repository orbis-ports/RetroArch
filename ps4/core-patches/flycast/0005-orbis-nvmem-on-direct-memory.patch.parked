 // Resets a chunk of memory by deleting its data and setting its protection back.
 void reset_mem(void *ptr, unsigned size_bytes) {
+#ifdef __ORBIS__
+	// ⚠ NOTHING TO DO, AND THAT IS A DECISION RATHER THAN AN OMISSION.
+	//
+	// The only caller is addrspace::bm_reset, and what it wants is for the FPCB to fault again so
+	// that bm_vmem_pagefill can refill each page as it is touched. There is no such state here:
+	// the FPCB is direct memory, committed whole in init() because this allocator cannot express
+	// "reserved but not yet backed" - see the block there. Making it PROT_NONE would produce
+	// faults nothing can answer, since virtmem::ondemand_page has no way to conjure backing for
+	// an already-mapped range, and madvise has no meaning for direct memory at all.
+	//
+	// hw/mem/addrspace.cpp's bm_reset is patched to call bm_vmem_pagefill directly on this
+	// platform instead, which is exactly what it already does when nvmem is off.
+	(void)ptr;
+	(void)size_bytes;
+#else
 	// Mark them as non accessible.
 	mprotect(ptr, size_bytes, PROT_NONE);
 	// Tell the kernel to flush'em all (FIXME: perhaps unmap+mmap 'd be better?)
@@ -223,6 +667,7 @@
 	#elif defined(MADV_FREE)
 	madvise(ptr, size_bytes, MADV_FREE);
 	#endif
+#endif
 }
 
 // Allocates a bunch of memory (page aligned and page-sized)
diff --git a/core/hw/mem/addrspace.cpp b/core/hw/mem/addrspace.cpp
--- a/core/hw/mem/addrspace.cpp
+++ b/core/hw/mem/addrspace.cpp
@@ -346,12 +346,27 @@
 // or by flushing it and making it fault on access again.
 void bm_reset()
 {
+#ifdef __ORBIS__
+	// ⚠ ONE BRANCH HERE, BECAUSE THIS PLATFORM'S FPCB IS COMMITTED EITHER WAY.
+	//
+	// The nvmem arm below asks virtmem::reset_mem to make the jump table fault again, so that each
+	// page is refilled by bm_lockedWrite as it is next touched. core/linux/posix_vmem.cpp's
+	// __ORBIS__ backing cannot offer that: it is direct memory, which sceKernelMapDirectMemory
+	// commits eagerly, so the table is real pages from init() onwards and there is no "not backed
+	// yet" for a fault to mean. reset_mem is a documented no-op there and says so.
+	//
+	// The refill happens here instead - which is the same call the non-nvmem arm below already
+	// makes, over the same 128 MiB, on exactly the same schedule. Turning nvmem on does not make
+	// this any more expensive than it is today.
+	bm_vmem_pagefill((void**)p_sh4rcb->fpcb, sizeof(p_sh4rcb->fpcb));
+#else
 	// If we allocated it via vmem:
 	if (ram_base)
 		virtmem::reset_mem(p_sh4rcb->fpcb, sizeof(p_sh4rcb->fpcb));
 	else
 		// We allocated it via a regular malloc/new/whatever on the heap
 		bm_vmem_pagefill((void**)p_sh4rcb->fpcb, sizeof(p_sh4rcb->fpcb));
+#endif
 }
 
